                  "pm.test('the three seeded roles', () => {",
                  "  const names = pm.response.json().map((role) => role.name);",
                  "  pm.expect(names).to.include.members(['Admin', 'User', 'ReadOnlyUser']);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/roles", "host": ["{{baseUrl}}"], "path": ["api", "roles"] },
            "description": "Read-only reference data: Admin (1), User (2), ReadOnlyUser (3)."
          }
        }
      ]
    },
    {
      "name": "5. Audit",
      "item": [
        {
          "name": "List audit entries",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('no password or token material anywhere in the trail', () => {",
                  "  const raw = pm.response.text();",
                  "  pm.expect(raw).to.not.include('AQAAAA');",
                  "  pm.expect(raw).to.not.include('tokenHash');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/audit-logs?pageSize=25",
              "host": ["{{baseUrl}}"],
              "path": ["api", "audit-logs"],
              "query": [
                { "key": "pageSize", "value": "25" },
                { "key": "action", "value": "RoleChange", "disabled": true }
              ]
            },
            "description": "Admin only, newest first. oldValues and newValues are parsed JSON objects. Password material appears as \"***\" - the event is visible, the value is not."
          }
        },
        {
          "name": "Audit entries for one user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "const items = pm.response.json().items;",
                  "",
                  "pm.test('the full lifecycle was recorded', () => {",
                  "  const actions = items.map((entry) => entry.action);",
                  "  pm.expect(actions).to.include('Insert');",
                  "  pm.expect(actions).to.include('Update');",
                  "  pm.expect(actions).to.include('RoleChange');",
                  "  pm.expect(actions).to.include('Delete');",
                  "  pm.expect(actions).to.include('Restore');",
                  "});",
                  "",
                  "pm.test('every entry names the immutable user id and captures an actor and an IP', () => {",
                  "  items.forEach((entry) => {",
                  "    pm.expect(entry.entityId).to.eql(pm.collectionVariables.get('userId'));",
                  "    pm.expect(entry.performedByUsername).to.be.a('string').and.not.empty;",
                  "    pm.expect(entry.ipAddress).to.be.a('string').and.not.empty;",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/audit-logs?entityId={{userId}}&pageSize=50",
              "host": ["{{baseUrl}}"],
              "path": ["api", "audit-logs"],
              "query": [
                { "key": "entityId", "value": "{{userId}}" },
                { "key": "pageSize", "value": "50" }
              ]
            },
            "description": "Filtered by the immutable user id, never by username - usernames are released when a user is deleted, so filtering by name could mix two different people. This shows the whole lifecycle performed by folder 2."
          }
        }
      ]
    },
    {
      "name": "6. Health",
      "item": [
        {
          "name": "Health",
          "event": [
