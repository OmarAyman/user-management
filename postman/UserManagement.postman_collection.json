          }
        },
        {
          "name": "User reads its own profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('it is jdoe, resolved from the token', () => {",
                  "  pm.expect(body.username).to.eql(pm.collectionVariables.get('userUsername'));",
                  "});",
                  "",
                  "// A concurrency token belongs to one row. Reusing the token captured for another user would",
                  "// fail as stale, which is the guard working correctly - so each subject reads its own first.",
                  "pm.collectionVariables.set('rowVersion', body.rowVersion);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/users/me", "host": ["{{baseUrl}}"], "path": ["api", "users", "me"] }
