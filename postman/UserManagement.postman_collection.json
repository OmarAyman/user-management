{
  "info": {
    "name": "User Management API",
    "description": "Every endpoint, organised so that **Run collection** passes end to end in this order.\n\nThe order is deliberate. Sign-in comes first and captures the access token; the alternate-role sign-ins live in the last folder because signing in as somebody else replaces the refresh cookie, and sign-out lives at the end because it ends the session everything above depends on. The password-change pair changes the admin password and changes it straight back, so a second run starts from the same state.\n\nThe refresh token never appears in a response body - it is an httpOnly cookie, which Postman keeps in its own jar. That is why *Refresh session* needs no input.\n\nSend `Accept-Language: ar` on any request, or add `?culture=ar`, for Arabic titles and messages. The `errorCode` never changes: that is the contract clients branch on.\n\nRuntime values (`accessToken`, `userId`, `rowVersion`) are collection variables written by test scripts. The environment deliberately carries only `baseUrl` - an environment variable of the same name would shadow the captured value and every authenticated request would fail with 401.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5080", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "userId", "value": "", "type": "string" },
    { "key": "rowVersion", "value": "", "type": "string" },
    { "key": "createdUsername", "value": "", "type": "string" },
    { "key": "adminUsername", "value": "admin", "type": "string" },
    { "key": "adminPassword", "value": "Admin@123456", "type": "string" },
    { "key": "temporaryPassword", "value": "Rotated@1234567", "type": "string" },
    { "key": "userUsername", "value": "jdoe", "type": "string" },
    { "key": "userPassword", "value": "User@1234567", "type": "string" },
    { "key": "readOnlyUsername", "value": "readonly", "type": "string" },
    { "key": "readOnlyPassword", "value": "ReadOnly@1234", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', body.accessToken);",
                  "",
                  "pm.test('returns the caller identity', () => {",
                  "  pm.expect(body.user.username).to.eql(pm.collectionVariables.get('adminUsername'));",
                  "  pm.expect(body.user.role).to.eql('Admin');",
                  "});",
                  "",
                  "pm.test('never returns a refresh token or password material in the body', () => {",
                  "  const raw = pm.response.text();",
                  "  pm.expect(raw).to.not.include('refreshToken');",
                  "  pm.expect(raw).to.not.include('passwordHash');",
                  "});",
                  "",
                  "pm.test('sets an httpOnly refresh cookie', () => {",
                  "  const header = pm.response.headers.get('Set-Cookie') || '';",
                  "  pm.expect(header.toLowerCase()).to.include('httponly');",
                  "  pm.expect(header.toLowerCase()).to.include('samesite=strict');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "description": "Signs in and captures the access token for every request below. Also sets the rotating refresh token as an httpOnly cookie."
          }
        },
        {
          "name": "Login (wrong password)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 with a generic code', () => {",
                  "  pm.response.to.have.status(401);",
                  "  pm.expect(pm.response.json().errorCode).to.eql('INVALID_CREDENTIALS');",
                  "});",
                  "",
                  "pm.test('discloses nothing about the account', () => {",
                  "  const raw = pm.response.text().toLowerCase();",
                  "  pm.expect(raw).to.not.include('locked');",
                  "  pm.expect(raw).to.not.include('deleted');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"no-such-user-{{$randomInt}}\",\n  \"password\": \"DefinitelyWrong@1\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "description": "An unknown username, a wrong password and a soft-deleted account all return this same response. A throwaway username is used on purpose: five wrong passwords against a real account lock it for 15 minutes."
          }
        },
        {
          "name": "Login (Arabic messages)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('the message is Arabic', () => {",
                  "  pm.expect(body.title).to.match(/[\\u0600-\\u06FF]/);",
                  "});",
                  "",
                  "pm.test('the machine-readable code is not translated', () => {",
                  "  pm.expect(body.errorCode).to.eql('INVALID_CREDENTIALS');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept-Language", "value": "ar" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"no-such-user-{{$randomInt}}\",\n  \"password\": \"DefinitelyWrong@1\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "description": "The title and detail come back in Arabic; errorCode does not change. Add ?culture=ar for the same effect without a header."
          }
        }
      ]
    },
    {
      "name": "2. Users",
      "item": [
        {
          "name": "List users",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "const page = pm.response.json();",
                  "",
                  "pm.test('carries paging metadata', () => {",
                  "  pm.expect(page).to.have.property('totalCount');",
                  "  pm.expect(page).to.have.property('totalPages');",
                  "  pm.expect(page.items).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('never exposes password material', () => {",
                  "  const raw = pm.response.text();",
                  "  pm.expect(raw).to.not.include('passwordHash');",
                  "  pm.expect(raw).to.not.include('securityStamp');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users?pageNumber=1&pageSize=10&sortBy=createdAt&sortDirection=Descending",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"],
              "query": [
                { "key": "pageNumber", "value": "1" },
                { "key": "pageSize", "value": "10" },
                { "key": "sortBy", "value": "createdAt", "description": "username | email | firstName | lastName | role | createdAt" },
                { "key": "sortDirection", "value": "Descending" },
                { "key": "search", "value": "", "disabled": true },
                { "key": "roleId", "value": "1", "disabled": true }
              ]
            },
            "description": "Active users only. There is no includeDeleted parameter: deleted users live behind their own Admin-only route, because soft-delete visibility is an authorization decision rather than a value a client passes."
          }
        },
        {
          "name": "List users (search + role filter)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users?search=khalil&roleId=2&pageSize=25",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"],
              "query": [
                { "key": "search", "value": "khalil" },
                { "key": "roleId", "value": "2" },
                { "key": "pageSize", "value": "25" }
              ]
            },
            "description": "Search covers username, email, first name and last name, and runs in SQL."
          }
        },
        {
          "name": "List users (invalid sort field)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 INVALID_SORT_FIELD', () => {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.json().errorCode).to.eql('INVALID_SORT_FIELD');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users?sortBy=passwordHash",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"],
              "query": [{ "key": "sortBy", "value": "passwordHash" }]
            },
            "description": "The sort field is a whitelist, so client input selects a branch and never becomes part of a query string."
          }
        },
        {
          "name": "List deleted users (Admin only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('200 OK for an administrator', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/users/deleted", "host": ["{{baseUrl}}"], "path": ["api", "users", "deleted"] },
            "description": "403 for User and ReadOnlyUser - see the last folder. The only read path over soft-deleted rows."
          }
        },
        {
          "name": "Check availability",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('a taken username reports unavailable', () => {",
                  "  pm.expect(pm.response.json().usernameAvailable).to.eql(false);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/availability?username={{adminUsername}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "availability"],
              "query": [{ "key": "username", "value": "{{adminUsername}}" }]
            },
            "description": "Advisory only - the unique index decides. Checked against active users, so a deleted user's identifiers report as available."
          }
        },
        {
          "name": "Create user",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// One name for both the username and the email, so the created user is easy to find later.",
                  "pm.collectionVariables.set('createdUsername', 'postman' + Date.now().toString().slice(-7));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created with a Location header', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(pm.response.headers.get('Location')).to.be.a('string');",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('userId', body.id);",
                  "pm.collectionVariables.set('rowVersion', body.rowVersion);",
                  "",
                  "pm.test('returns a concurrency token and no password material', () => {",
                  "  pm.expect(body.rowVersion).to.be.a('string').and.not.empty;",
                  "  pm.expect(pm.response.text()).to.not.include('passwordHash');",
                  "});",
                  "",
                  "pm.test('stamps who created it', () => {",
                  "  pm.expect(body.createdBy).to.eql(pm.collectionVariables.get('adminUsername'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{createdUsername}}\",\n  \"email\": \"{{createdUsername}}@example.com\",\n  \"firstName\": \"Post\",\n  \"lastName\": \"Man\",\n  \"password\": \"Created@123456\",\n  \"roleId\": 2\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"] },
            "description": "Admin only. Captures the new id and its rowVersion for the requests below."
          }
        },
        {
          "name": "Create user (duplicate username)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 USERNAME_ALREADY_EXISTS', () => {",
                  "  pm.response.to.have.status(409);",
                  "  pm.expect(pm.response.json().errorCode).to.eql('USERNAME_ALREADY_EXISTS');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{createdUsername}}\",\n  \"email\": \"different-{{$randomInt}}@example.com\",\n  \"firstName\": \"Post\",\n  \"lastName\": \"Man\",\n  \"password\": \"Created@123456\",\n  \"roleId\": 2\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"] },
            "description": "Uniqueness is scoped to active users, and the filtered unique index is the final authority under a race."
          }
        },
        {
          "name": "Create user (weak password)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 VALIDATION_ERROR naming the field', () => {",
                  "  pm.response.to.have.status(400);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.errorCode).to.eql('VALIDATION_ERROR');",
                  "  pm.expect(body.errors).to.have.property('password');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"weak{{$randomInt}}\",\n  \"email\": \"weak-{{$randomInt}}@example.com\",\n  \"firstName\": \"Weak\",\n  \"lastName\": \"Password\",\n  \"password\": \"short\",\n  \"roleId\": 2\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"] },
            "description": "Field-level errors come back keyed by the JSON field name, so a form can render each message next to the input that caused it."
          }
        },
        {
          "name": "Get user by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('rowVersion', pm.response.json().rowVersion);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userId}}"] },
            "description": "Refreshes the captured rowVersion. Run this before an update if a previous write changed the row."
          }
        },
        {
          "name": "Update user (includes role)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('the role changed and a new concurrency token was issued', () => {",
                  "  pm.expect(body.role).to.eql('ReadOnlyUser');",
                  "  pm.expect(body.rowVersion).to.not.eql(pm.collectionVariables.get('rowVersion'));",
                  "});",
                  "",
                  "pm.collectionVariables.set('rowVersion', body.rowVersion);"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{createdUsername}}@example.com\",\n  \"firstName\": \"Updated\",\n  \"lastName\": \"Man\",\n  \"roleId\": 3,\n  \"rowVersion\": \"{{rowVersion}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userId}}"] },
            "description": "No username field (immutable), no password (its own endpoint) and no isDeleted (delete has its own route). rowVersion is required."
          }
        },
        {
          "name": "Update user (stale concurrency token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 RESOURCE_MODIFIED', () => {",
                  "  pm.response.to.have.status(409);",
                  "  pm.expect(pm.response.json().errorCode).to.eql('RESOURCE_MODIFIED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{createdUsername}}@example.com\",\n  \"firstName\": \"Stale\",\n  \"lastName\": \"Write\",\n  \"roleId\": 2,\n  \"rowVersion\": \"AAAAAAAAAAE=\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userId}}"] },
            "description": "A deliberately wrong token, showing the lost-update guard refuse the write."
          }
        },
        {
          "name": "Delete user (soft)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('204 No Content', () => pm.response.to.have.status(204));"]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userId}}"] },
            "description": "Soft delete. No user is ever physically deleted through the API."
          }
        },
        {
          "name": "Delete user again (already deleted)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 USER_ALREADY_DELETED, not 404', () => {",
                  "  pm.response.to.have.status(409);",
                  "  pm.expect(pm.response.json().errorCode).to.eql('USER_ALREADY_DELETED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userId}}"] },
            "description": "An administrator needs to tell 'already gone' from 'never existed', so this is a conflict rather than a not-found."
          }
        },
        {
          "name": "Get deleted user (refresh token for restore)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK - an administrator can read a deleted user', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('it is marked deleted', () => pm.expect(body.isDeleted).to.eql(true));",
                  "",
                  "// The delete changed the row, so the token held before it is now stale by design.",
                  "pm.collectionVariables.set('rowVersion', body.rowVersion);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userId}}"] }
          }
        },
        {
          "name": "Restore user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('204 No Content', () => pm.response.to.have.status(204));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"rowVersion\": \"{{rowVersion}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/users/{{userId}}/restore", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userId}}", "restore"] },
            "description": "Restore also re-checks that the username and email are still free, because deletion releases them."
          }
        }
      ]
    },
    {
      "name": "3. Profile",
      "item": [
        {
          "name": "Get my profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('rowVersion', body.rowVersion);",
                  "",
                  "pm.test('it is the token subject, not an id from the request', () => {",
                  "  pm.expect(body.username).to.eql(pm.collectionVariables.get('adminUsername'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/users/me", "host": ["{{baseUrl}}"], "path": ["api", "users", "me"] },
            "description": "No id in the route: the subject comes from the validated token, which is why there is nothing here for an attacker to swap."
          }
        },
        {
          "name": "Update my profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('rowVersion', pm.response.json().rowVersion);"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"System\",\n  \"lastName\": \"Administrator\",\n  \"email\": \"admin@example.com\",\n  \"rowVersion\": \"{{rowVersion}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/users/me", "host": ["{{baseUrl}}"], "path": ["api", "users", "me"] },
            "description": "Three fields, and the same values the seed uses - so running the collection twice changes nothing."
          }
        },
        {
          "name": "Update my profile (mass assignment attempt)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 - unexpected fields are refused, not ignored', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"System\",\n  \"lastName\": \"Administrator\",\n  \"email\": \"admin@example.com\",\n  \"rowVersion\": \"{{rowVersion}}\",\n  \"roleId\": 1,\n  \"isDeleted\": false\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/users/me", "host": ["{{baseUrl}}"], "path": ["api", "users", "me"] },
            "description": "The payload the brief names. The model has no role or isDeleted field to bind, and unmapped members are rejected rather than silently dropped."
          }
        },
        {
          "name": "Change my password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('204 No Content', () => pm.response.to.have.status(204));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"{{adminPassword}}\",\n  \"newPassword\": \"{{temporaryPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/users/me/change-password", "host": ["{{baseUrl}}"], "path": ["api", "users", "me", "change-password"] },
            "description": "Requires the current password. On success every refresh-token family for this user is revoked - the access token keeps working until it expires, which is why the requests after this one still pass."
          }
        },
        {
          "name": "Change my password back",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));",
                  "pm.test('the seed password is restored, so a second run starts clean', () => {",
                  "  pm.expect(pm.response.code).to.eql(204);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"{{temporaryPassword}}\",\n  \"newPassword\": \"{{adminPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/users/me/change-password", "host": ["{{baseUrl}}"], "path": ["api", "users", "me", "change-password"] },
            "description": "Deliberately paired with the request above: a collection that leaves the demo account on a changed password would fail the next time anyone ran it."
          }
        },
        {
          "name": "Change my password (wrong current password)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 INVALID_CREDENTIALS', () => {",
                  "  pm.response.to.have.status(401);",
                  "  pm.expect(pm.response.json().errorCode).to.eql('INVALID_CREDENTIALS');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"NotTheRightOne@1\",\n  \"newPassword\": \"Whatever@1234567\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/users/me/change-password", "host": ["{{baseUrl}}"], "path": ["api", "users", "me", "change-password"] },
            "description": "A stolen access token is not enough to take over an account: proof of the current password is required."
          }
        }
      ]
    },
    {
      "name": "4. Roles",
      "item": [
