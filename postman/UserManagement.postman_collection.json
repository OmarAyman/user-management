              "mode": "raw",
              "raw": "{\n  \"email\": \"hijacked@example.com\",\n  \"firstName\": \"Hi\",\n  \"lastName\": \"Jacked\",\n  \"roleId\": 1,\n  \"rowVersion\": \"AAAAAAAAAAE=\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userId}}"] },
