# Copy to .env and fill in. .env is gitignored; this file is not, and carries no real values.
#
#   cp .env.example .env

# SQL Server's sa password. Must satisfy its complexity rules: 8+ characters with upper, lower, digit and
# symbol, or the container exits during startup.
MSSQL_SA_PASSWORD=ChangeMe_Local#2026

# JWT signing key, 32 characters minimum. The API refuses to start in Production without a usable one - a
# deployment running on a placeholder key is worse than one that fails loudly.
JWT_KEY=replace-with-at-least-32-random-characters

# Demo account passwords. Development-only credentials for a reviewer; never use them anywhere real.
SEED_ADMIN_PASSWORD=Admin@123456
SEED_USER_PASSWORD=User@1234567
SEED_READONLY_PASSWORD=ReadOnly@1234
