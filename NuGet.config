<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- <clear /> drops any feed inherited from the machine or user configuration. A reviewer cloning this
       repository restores from exactly one public source, so the build does not depend on a private feed
       that only exists on the original developer's machine. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!-- Explicit mapping is required by central package management once more than one source can be in play,
       and it removes the dependency-confusion risk of a package resolving from an unexpected feed. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
